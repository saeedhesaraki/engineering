{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "engineering",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9a7a8430-a654-4e7c-b9e8-008d3e335b0a","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "860424f946ba4ae7bf0648e4afbf4889" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
